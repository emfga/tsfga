{
  "name": "@tsfga/kysely",
  "version": "0.5.0",
  "type": "module",
  "author": "Lemuel Roberto Bonifacio <code@lemuelroberto.online>",
  "description": "Kysely/PostgreSQL adapter for @tsfga/core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emfga/tsfga.git",
    "directory": "packages/kysely"
  },
  "homepage": "https://github.com/emfga/tsfga/tree/main/packages/kysely",
  "bugs": {
    "url": "https://github.com/emfga/tsfga/issues"
  },
  "keywords": [
    "openfga",
    "rebac",
    "authorization",
    "kysely",
    "postgresql",
    "zanzibar"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "import": "./dist/migrations/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "db:generate": "bunx kysely-codegen --out-file src/schema.ts",
    "db:latest": "kysely migrate:latest",
    "db:rollback": "kysely migrate:rollback --all",
    "test": "bun test",
    "test:node": "node --import tsx --import ../../tests/node/register.mjs --test 'tests/*.test.ts'",
    "test:deno": "deno test --no-check --allow-all --config ../../tests/deno/deno.json tests/",
    "tsc": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tsfga/core": ">=0.6.0 <0.7.0",
    "kysely": ">=0.27.0 <0.30.0",
    "pg": ">=8.0.0"
  },
  "devDependencies": {
    "@tsfga/core": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/pg": "8.20.4",
    "kysely": "0.29.4",
    "kysely-codegen": "0.20.0",
    "kysely-ctl": "0.21.0",
    "pg": "8.22.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
