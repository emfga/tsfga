{
  "name": "tsfga",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": ["packages/*", "tests/*"],
  "scripts": {
    "biome:check": "biome check .",
    "check:peer-range": "scripts/check-peer-range.sh",
    "check:schema-drift": "scripts/check-schema-drift.sh",
    "check:write-gate-causes": "node scripts/check-write-gate-causes.mjs",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint .",
    "db:generate": "turbo run db:generate",
    "db:latest": "turbo run db:latest",
    "db:rollback": "turbo run db:rollback",
    "infra:down": "docker compose down -v",
    "infra:setup": "docker compose up -d --wait && turbo run db:latest",
    "infra:up": "docker compose up -d --wait",
    "build": "turbo run build",
    "tsc": "turbo run tsc tsc:harness",
    "tsc:harness": "tsc -p tsconfig.harness.json && deno check --no-lock tests/deno/bun-test-shim.ts && node scripts/check-readme-samples.mjs",
    "turbo:test": "turbo run test",
    "turbo:test:conformance": "turbo run test --filter=@tsfga/conformance",
    "turbo:test:core": "turbo run test --filter=@tsfga/core",
    "turbo:test:kysely": "turbo run test --filter=@tsfga/kysely",
    "turbo:test:deno": "turbo run test:deno",
    "turbo:test:node": "turbo run test:node"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/bun": "1.4.4",
    "publint": "0.3.25",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
